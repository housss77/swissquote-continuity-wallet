    "verify:onchain": "tsx scripts/verify-onchain.ts",
    "check:provider": "tsx scripts/check-provider.ts"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "4.1.0",
    "@safe-global/relay-kit": "3.1.0",
    "next": "16.4.0",
