    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "overrides": {
    "axios": "1.20.0",
    "ws": "8.22.0",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
