{
  "name": "swissquote-continuity-wallet-spike",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "scripts": {
    "demo:check": "tsx scripts/demo-readiness.ts",
    "demo:screenshots": "node scripts/capture-ui.mjs",
    "dev": "next dev --webpack --hostname localhost",
    "build": "next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:live-read": "playwright test --config playwright.live.config.ts",
    "verify:onchain": "tsx scripts/verify-onchain.ts",
    "check:provider": "tsx scripts/check-provider.ts",
    "prepare:recovery-contract": "node scripts/prepare-recovery-contract.mjs",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:recovery:server": "node --conditions=react-server --import=tsx --test tests/recovery/server.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "setup:recovery-demo": "node scripts/setup-recovery-demo.mjs",
    "deploy:recovery": "tsx scripts/deploy-recovery.ts",
    "test:recovery:sepolia": "node scripts/test-recovery-sepolia.mjs"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "4.1.0",
    "@safe-global/relay-kit": "3.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "viem": "2.57.4"
  },
  "overrides": {
    "axios": "1.20.0",
    "ws": "8.22.0",
    "ethers": "6.17.0",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "assert": "2.1.0",
    "buffer": "6.0.3",
    "esbuild": "0.25.12",
    "events": "3.3.0",
    "process": "0.11.10",
    "solc": "0.8.20",
    "stream-browserify": "3.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
