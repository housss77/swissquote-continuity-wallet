{
  "name": "swissquote-continuity-wallet-spike",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": { "node": "24.16.0", "npm": "11.13.0" },
  "scripts": {
    "dev": "next dev --webpack --hostname localhost",
    "build": "next build --webpack",
    "start": "next start --hostname localhost",
    "typecheck": "tsc --noEmit",
